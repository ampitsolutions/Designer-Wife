# Copy to .env and fill in. Never commit .env.

# App (safe to ship in the app — protected by row level security)
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Server-side only — set as Supabase Edge Function secrets, NOT in the app
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=wardrobe-photos
GEMINI_API_KEY=
